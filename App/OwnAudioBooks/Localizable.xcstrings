      }
    },
    "Stops at the end of the book": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví na konci knihy"
          }
        }
      }
    },
    "Stops at the end of this chapter": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví na konci této kapitoly"
          }
        }
      }
    },
    "Stops in": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví za"
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úložiště"
          }
        }
      }
    },
    "Storage is paid from the family's prepaid credit, day by day; the family's admin tops it up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úložiště se platí z předplaceného kreditu rodiny, den po dni; dobíjí ho správce rodiny."
          }
        }
      }
    },
    "Streaming": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamování"
          }
        }
      }
    },
    "Swipe a device to sign it out. Signing out everywhere ends every session, this iPhone's too, and asks for a fresh sign-in.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím zařízení odhlásíte. Odhlášení všude ukončí všechny relace včetně tohoto iPhonu a vyžádá si nové přihlášení."
          }
        }
      }
    },
    "That Didn't Work": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To se nepovedlo"
          }
        }
      }
    },
    "That address does not answer as an own.audio or Audiobookshelf server.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na této adrese neodpovídá server own.audio ani Audiobookshelf."
          }
        }
      }
    },
    "That book is not in the library any more.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahle kniha už v knihovně není."
          }
        }
      }
    },
    "That code was not accepted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód nebyl přijat."
          }
        }
      }
    },
    "That doesn't look like a server address.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nevypadá jako adresa serveru."
          }
        }
      }
    },
    "The app writes here when something goes wrong.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace sem zapisuje, když se něco nepovede."
          }
        }
      }
    },
    "The book library this app shows from the server. With several, each is also in the switch on Home.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna knih, kterou aplikace ze serveru ukazuje. Je-li jich víc, má každá i vlastní položku v přepínači na kartě Domů."
          }
        }
      }
    },
    "The credit has run out: the family's admin can top it up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit došel: správce rodiny ho může dobít."
          }
        }
      }
    },
    "The family": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodina"
          }
        }
      }
    },
    "The files are copied and uploaded in the background; you can leave this screen. The book appears in the library once the upload is done.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory se zkopírují a nahrají na pozadí; tuto obrazovku můžete opustit. Kniha se v knihovně objeví, jakmile je nahrávání hotové."
          }
        }
      }
    },
    "The library shows the selected server.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna ukazuje vybraný server."
          }
        }
      }
    },
    "The library shows the selected server. A book keeps playing when you switch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna zobrazuje vybraný server. Rozehraná kniha hraje dál, i když server přepnete."
          }
        }
      }
    },
    "The narration failed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namlouvání se nezdařilo."
          }
        }
      }
    },
    "The position is forgotten on every device.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozice se zapomene na všech zařízeních."
          }
        }
      }
    },
    "The price is taken from the family's credit when the book is done. A narration takes minutes to hours; the Library shows how far it is, and the book appears there at the end.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena se strhne z kreditu rodiny, až bude kniha hotová. Namlouvání trvá minuty až hodiny; Knihovna ukazuje, jak daleko je, a na konci se tam kniha objeví."
          }
        }
      }
    },
    "The server answered with an error (%lld).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odpověděl chybou (%lld)."
          }
        }
      }
    },
    "The server could not be reached.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server není dostupný."
          }
        }
      }
    },
    "The server could not be reached. Check the address and your connection.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server není dostupný. Zkontrolujte adresu a připojení."
          }
        }
      }
    },
    "The server counts the characters it will read and quotes the price; nothing is charged until you start.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server spočítá znaky, které přečte, a sdělí cenu; nic se neúčtuje, dokud nezačnete."
          }
        }
      }
    },
    "The server did not allow that.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server to nedovolil."
          }
        }
      }
    },
    "The server did not send the file.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server soubor neposlal."
          }
        }
      }
    },
    "The server no longer has that.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server to už nemá."
          }
        }
      }
    },
    "The server refused that name and password.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmítl toto jméno a heslo."
          }
        }
      }
    },
    "The server refused the sign-in. Sign in again in Settings › Servers.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmítl přihlášení. Přihlaste se znovu v Nastavení › Servery."
          }
        }
      }
    },
    "The server tells the app its other addresses. Add one it doesn't know, such as a VPN like Tailscale; on each network the app uses the fastest that answers as this server.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server aplikaci sdělí své další adresy. Přidejte takovou, kterou nezná, třeba VPN jako Tailscale; v každé síti aplikace použije nejrychlejší, která odpovídá jako tento server."
          }
        }
      }
    },
    "The server's answer could not be read.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď serveru se nepodařilo přečíst."
          }
        }
      }
    },
    "The six-digit code from your authenticator app, or one of your recovery codes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šestimístný kód z vaší ověřovací aplikace, nebo jeden z vašich záložních kódů."
          }
        }
      }
    },
    "The storage refused the file (%lld).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úložiště soubor odmítlo (%lld)."
          }
        }
      }
    },
    "This account reaches no book library on that server.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemá na tomto serveru přístup k žádné knihovně knih."
          }
        }
      }
    },
    "This book is not on this iPhone. Download it, or turn Offline Mode off.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kniha není v tomto iPhonu. Stáhněte ji, nebo vypněte režim offline."
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení"
          }
        }
      }
    },
    "This library has no books yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V této knihovně zatím nejsou žádné knihy."
          }
        }
      }
    },
    "This own.audio server is too old for the app; update it to 1.0.0-beta.20 or later.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento server own.audio je pro aplikaci příliš starý; aktualizujte ho na 1.0.0-beta.20 nebo novější."
          }
        }
      }
    },
    "This server does not offer that.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento server to nenabízí."
          }
        }
      }
    },
    "This server's library is empty.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna tohoto serveru je prázdná."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název"
          }
        }
      }
    },
    "Titles, authors, narrators and series.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy, autoři, vypravěči a série."
          }
        }
      }
    },
    "Translating": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překládá se"
          }
        }
      }
