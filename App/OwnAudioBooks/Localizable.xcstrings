    "A Month at Today's Storage": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíc při dnešním úložišti"
          }
        }
      }
    },
    "A code from your authenticator is needed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba kód z vaší ověřovací aplikace."
          }
        }
      }
    },
    "A list of everything on the server, without the audio, so the library can be browsed offline. Updated at launch and when the app comes to the foreground.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam všeho na serveru, bez zvuku, aby šlo knihovnu procházet offline. Aktualizuje se při spuštění a při návratu aplikace do popředí."
          }
        }
      }
    },
    "A shared own.audio server with public-domain books. Remove it in Settings when you add your own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílený server own.audio s volně dostupnými knihami. Až přidáte vlastní server, odeberte ho v Nastavení."
          }
        }
      }
    },
